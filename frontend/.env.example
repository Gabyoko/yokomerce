# Copia este archivo a .env.local (no se sube a Git).

# URL completa de la API. Es completa (no relativa) porque los componentes de servidor también llaman a la API.
# - Backend real (fase C): http://localhost:8000
# - API de prueba dentro de Next.js (fase F): http://localhost:3000/api/mock
NEXT_PUBLIC_API_URL=http://localhost:8000

# Sesión de los dueños con Supabase Auth. Supabase > Project Settings:
# - Project URL (Data API), sin /rest/v1/ al final
# - Publishable key (API Keys), empieza con sb_publishable_
# Las dos son públicas (se ven en el navegador). NUNCA pongas aquí la secret key ni la service_role.
# Si se dejan vacías, el panel usa la sesión de prueba de la fase F (cookie mock_store).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# URL pública del sitio, para los links que se comparten (ej. "Ver pedido" en el mensaje de WhatsApp).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Planes: "false" durante la beta (todos se comportan como Pro).
NEXT_PUBLIC_PLANS_ENFORCED=false

# Opcional: WhatsApp de Yokomerce (9 dígitos) para que los negocios pidan el plan Pro.
# Si no está, la página de plan muestra "Muy pronto".
NEXT_PUBLIC_SUPPORT_WHATSAPP=
