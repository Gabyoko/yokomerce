# Copia este archivo a .env (no se sube a Git).

# development | test | production
APP_ENV=development

# PostgreSQL. En desarrollo lo levanta docker-compose.yml con estos mismos datos (solo locales).
DATABASE_URL=postgresql+psycopg://yokomerce:yokomerce@localhost:5432/yokomerce

# Dominios del front que pueden llamar a la API, separados por comas
CORS_ORIGINS=http://localhost:3000

# Sesión de los dueños. Una de estas dos formas:
# - Real (Supabase Auth; se configura al conectar el front en la fase C):
#     AUTH_JWKS_URL=https://<proyecto>.supabase.co/auth/v1/.well-known/jwks.json
#     AUTH_ISSUER=https://<proyecto>.supabase.co/auth/v1
# - Desarrollo, sin cuenta de Supabase: un secreto local de al menos 32 caracteres para dev_token.py.
#     Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(48))"
#     Nunca lo uses en producción: la app no arranca si lo intentas.
AUTH_JWKS_URL=
AUTH_ISSUER=
AUTH_DEV_SECRET=

# Planes: "false" durante la beta (todos se comportan como Pro). Debe coincidir con NEXT_PUBLIC_PLANS_ENFORCED del front.
PLANS_ENFORCED=false

# Dirección pública de esta API (las fotos guardadas en disco se sirven desde aquí)
PUBLIC_BASE_URL=http://localhost:8000

# Fotos: "local" guarda en UPLOADS_DIR (desarrollo); "supabase" en Supabase Storage (producción).
# Con supabase: crea un bucket PÚBLICO y pon la clave "service_role" (secreta: solo en el servidor).
STORAGE_BACKEND=local
UPLOADS_DIR=uploads
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=imagenes
